 #include "infrastructure/stringutil.h"

+namespace {
+
+UINT gLegacyTextCodePage = CP_ACP;
+
+std::string ucs2_to_codepage(const std::wstring &s, UINT codePage) {
+	if (s.empty()) {
+		return {};
+	}
+
+	auto len = WideCharToMultiByte(
+		codePage, 0,
+		s.data(), (int)s.size(),
+		nullptr, 0,
+		nullptr, nullptr
+	);
+	if (len <= 0) {
+		return {};
+	}
+
+	std::string result(len, '\0');
+	WideCharToMultiByte(
+		codePage, 0,
+		s.data(), (int)s.size(),
+		&result[0], len,
+		nullptr, nullptr
+	);
+	return result;
+}
+
+std::wstring codepage_to_ucs2(const std::string &s, UINT codePage) {
+	if (s.empty()) {
+		return {};
+	}
+
+	auto len = MultiByteToWideChar(
+		codePage, 0,
+		s.data(), (int)s.size(),
+		nullptr, 0
+	);
+	if (len <= 0) {
+		return {};
+	}
+
+	std::wstring result(len, L'\0');
+	MultiByteToWideChar(
+		codePage, 0,
+		s.data(), (int)s.size(),
+		&result[0], len
+	);
+	return result;
+}
+
+}
