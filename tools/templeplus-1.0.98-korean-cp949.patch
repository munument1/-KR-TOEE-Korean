+}
+
+std::string ucs2_to_legacy(const std::wstring &s) {
+	return ucs2_to_codepage(s, gLegacyTextCodePage);
+}
+
+std::wstring legacy_to_ucs2(const std::string &s) {
+	return codepage_to_ucs2(s, gLegacyTextCodePage);
